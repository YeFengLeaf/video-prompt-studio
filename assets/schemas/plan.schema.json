{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/video-prompt-studio/plan.schema.json",
  "title": "项目计划（plan.json）",
  "description": "多镜/多集项目的结构化计划；单条 Fast Lane 可不用。对应 references/00_交互协议.md §4.1。",
  "type": "object",
  "required": ["project_id", "model", "aspect", "segments", "assets"],
  "additionalProperties": false,
  "properties": {
    "project_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "model": {
      "type": "string",
      "enum": ["seedance-2.0", "seedance-2.5", "veo", "minimax-h3", "kling", "generic"]
    },
    "aspect": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:3", "auto"]},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration", "shots"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "t0", "t1", "size", "move", "action", "exit_state"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^S[0-9]{2}-[0-9]{2}$"},
                "t0": {"type": "number", "minimum": 0},
                "t1": {"type": "number", "exclusiveMinimum": 0},
                "size": {"type": "string", "enum": ["远景", "全景", "中景", "中近景", "近景", "特写"]},
                "move": {"type": "string", "maxLength": 20},
                "action": {"type": "string", "minLength": 1, "maxLength": 300},
                "exit_state": {"type": "string", "maxLength": 200}
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]{2,3}$"},
          "name": {"type": "string"},
          "role": {"type": "string", "maxLength": 40},
          "scope": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "assets-ready", "submitted", "generated", "reviewed"],
      "default": "planned"
    }
  }
}
